<Window x:Class="WarudoBridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Warudo Bridge"
        Width="1020" Height="700" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" FontFamily="Malgun Gothic" FontSize="13"
        Loaded="WindowLoaded" Closing="WindowClosing" PreviewKeyDown="WindowPreviewKeyDown">
  <Grid Margin="16,12,16,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Warudo Deck" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="TRIGGER / TOGGLE" Foreground="#828BA6" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6" Background="#23283B" Padding="10,6">
        <TextBlock x:Name="ConnectionBadge" Text="● 연결 대기" Foreground="#E3C784"/>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="WARUDO" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        <TextBox Grid.Column="1" x:Name="AddressBox" Padding="8,5" FontSize="12" AutomationProperties.Name="Warudo 연결 주소" ToolTip="기본 주소: ws://localhost:19069/"/>
        <Button Grid.Column="2" Content="연결" Click="ConnectClicked" Padding="12,5" Margin="8,0,6,0"/>
        <Button Grid.Column="3" x:Name="RefreshButton" Content="↻ 새로고침" Padding="12,5" Click="RefreshClicked" IsEnabled="False"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBox x:Name="SearchBox" Padding="10,7" TextChanged="FilterChanged" AutomationProperties.Name="수신자 검색" ToolTip="수신자 이름 검색 (Ctrl+F)"/>
      <TextBlock x:Name="SearchHint" Text="수신자 이름 검색…" Foreground="#929BB8" Margin="11,8" IsHitTestVisible="False"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
        <RadioButton x:Name="AllFilter" GroupName="filter" Content="전체" IsChecked="True" Checked="FilterChanged"/>
        <RadioButton x:Name="TriggerFilter" GroupName="filter" Content="Trigger" Checked="FilterChanged"/>
        <RadioButton x:Name="ToggleFilter" GroupName="filter" Content="Toggle" Checked="FilterChanged"/>
        <RadioButton x:Name="FavoriteFilter" GroupName="filter" Content="★ 즐겨찾기" Checked="FilterChanged"/>
      </StackPanel>
      <TextBlock Grid.Row="1" x:Name="CountLabel" Text="0개" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
    <Grid Grid.Row="3">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <ItemsControl x:Name="ReceiverList">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Grid Width="104" Height="104" Margin="0,0,8,8">
              <Button Click="ExecuteClicked" IsEnabled="{Binding CanExecute}" Style="{StaticResource DeckKeyStyle}"
                      ToolTip="{Binding Name}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Name}">
                <Grid IsHitTestVisible="False">
                  <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
                  <TextBlock Text="{Binding KindLabel}" FontSize="8" FontWeight="Bold" Foreground="#9D94C9" VerticalAlignment="Top"/>
                  <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                             FontSize="12" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" MaxHeight="48" LineHeight="16"/>
                  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Ellipse Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center">
                      <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#736A99"/>
                        <Style.Triggers><DataTrigger Binding="{Binding ToggleState}" Value="True"><Setter Property="Fill" Value="#73E3AE"/></DataTrigger></Style.Triggers>
                      </Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="9">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding StateLabel}"/><Setter Property="Foreground" Value="#AAA6BD"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ToggleState}" Value="True"><Setter Property="Foreground" Value="#73E3AE"/></DataTrigger>
                          <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Text" Value="전송 중…"/></DataTrigger>
                        </Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </Button>
              <Button Content="{Binding FavoriteLabel}" Click="FavoriteClicked" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,4,4,0" Padding="3,0" Background="Transparent" BorderBrush="Transparent" Foreground="#EAD28D"
                      FontSize="13" ToolTip="즐겨찾기 변경" AutomationProperties.Name="즐겨찾기 변경"/>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540" Margin="20">
        <TextBlock x:Name="EmptyTitle" Text="Warudo를 기다리는 중" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="EmptyDescription" Text="Warudo에서 Stream Deck Trigger 또는 Toggle 노드를 추가하고 수신자 이름을 지정하세요." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="4" BorderBrush="#2B3145" BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,6,0,0">
      <TextBlock x:Name="StatusLabel" Text="연결을 준비하고 있습니다." TextTrimming="CharacterEllipsis" MaxHeight="24"
                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{StaticResource MutedBrush}"/>
    </Border>
  </Grid>
</Window>
