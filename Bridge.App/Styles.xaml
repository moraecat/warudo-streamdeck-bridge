<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#11131C" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1B1E2C" />
    <SolidColorBrush x:Key="MutedBrush" Color="#ABB1C8" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F4FC" /></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F4FC"/><Setter Property="Background" Value="#30364D"/>
      <Setter Property="BorderBrush" Value="#444C69"/><Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Shell" CornerRadius="7" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#B8A4FF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#E5DAFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DeckKeyStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="Background" Value="#222331"/><Setter Property="BorderBrush" Value="#454357"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="KeyEdge" CornerRadius="10" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="#0B0C12" Padding="3,3,3,5">
          <Border x:Name="KeyFace" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="#353445" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </Border>
        </Border>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding ToggleState}" Value="True">
            <Setter TargetName="KeyEdge" Property="BorderBrush" Value="#56BB91"/>
            <Setter TargetName="KeyFace" Property="Background" Value="#19332D"/>
          </DataTrigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="KeyEdge" Property="BorderBrush" Value="#B5A0FF"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="KeyEdge" Property="BorderBrush" Value="#D6C9FF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="KeyFace" Property="RenderTransform"><Setter.Value><TranslateTransform Y="2"/></Setter.Value></Setter><Setter TargetName="KeyFace" Property="Opacity" Value="0.72"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="KeyEdge" Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F4F4FC"/><Setter Property="Background" Value="#141723"/>
      <Setter Property="BorderBrush" Value="#444C69"/><Setter Property="CaretBrush" Value="White"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C9CCDC"/><Setter Property="Background" Value="#24293A"/>
      <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="#6351B7"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Opacity" Value="0.8"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
